# ── LLMs ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Estrategia LLM
PRIMARY_LLM=groq
FALLBACK_LLM=ollama
LONG_CONTEXT_LLM=gemini

# Modelos — verificar IDs exactos en build time
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=qwen2.5:32b

# ── Datos US ───────────────────────────────────────────────────────────
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_KEY=
# yfinance no necesita key

# ── Datos Crypto ───────────────────────────────────────────────────────
COINGECKO_API_KEY=

# ── Sentimiento ────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockBot/1.0

# ── Base de datos ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./stockbot.db
# DATABASE_URL=postgresql://stockbot:stockbot_dev@localhost:5432/stockbot

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-en-produccion
DEBUG=true
LOG_LEVEL=INFO
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# SEC EDGAR identity (requerido)
SEC_IDENTITY_NAME=StockBot
SEC_IDENTITY_EMAIL=
